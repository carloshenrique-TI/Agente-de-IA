# 2. LEITURA DOS PDFS ANTIGOS (BASE DE CONHECIMENTO)
@st.cache_data
def carregar_base_conhecimento():
    texto_completo = ""
    pasta_pops = "pops"
    if os.path.exists(pasta_pops):
        for ficheiro in os.listdir(pasta_pops):
            if ficheiro.endswith(".pdf"):
                caminho = os.path.join(pasta_pops, ficheiro)
                doc = fitz.open(caminho)
                for pagina in doc:
                    texto_completo += pagina.get_text()
                doc.close()
    return texto_completo

conhecimento_pops = carregar_base_conhecimento()

# --- FUNÇÃO MESTRE PARA GERAR O LAYOUT DO PDF ---
def criar_pdf_documento_visual(conteudo_texto, titulo_processo):
    pdf = FPDF()
    pdf.add_page()
    
    # --- LAYOUT CABEÇALHO ---
    pdf.set_fill_color(106, 13, 173) # Tom de roxo Futura
    pdf.rect(0, 0, 210, 40, 'F')
    
    # Logotipo do Mascote no topo (Usando o nome exato do seu arquivo)
    if os.path.exists("15_oVGnI3dW.jpg"):
        pdf.image("15_oVGnI3dW.jpg", 10, 5, 30) 
    
    # Título do Documento
    pdf.set_font("Arial", "B", 18)
    pdf.set_text_color(255, 255, 255) 
    pdf.set_xy(45, 15)
    pdf.cell(0, 10, f"POP OFICIAL: {titulo_processo[:30]}...", ln=True)
    
    # --- CONTEÚDO DO DOCUMENTO (COM LEITOR DE IMAGENS) ---
    pdf.set_xy(10, 50)
    pdf.set_text_color(0, 0, 0)
    pdf.set_font("Arial", "", 12)
    
    # Limpeza básica do texto
    texto_limpo = conteudo_texto.replace("**", "").replace("📄 ", "").replace("🛠️ ", "").replace("⚠️ ", "")
    texto_limpo = texto_limpo.encode('latin-1', 'replace').decode('latin-1')
    
    # Lógica para inserir imagens no meio do texto
    linhas = texto_limpo.split('\n')
    for linha in linhas:
        linha = linha.strip()
        
        # 🛡️ EVOLUÇÃO ANTI-CRASH: Quebra palavras, links ou traços gigantes que travam o PDF
        palavras = linha.split(" ")
        palavras_seguras = [p[:80] if len(p) > 80 else p for p in palavras]
        linha = " ".join(palavras_seguras)
        
        if "[IMAGEM:" in linha:
            try:
                # Extrai o nome da imagem (Ex: [IMAGEM: print1.jpg])
                nome_img = linha.split("[IMAGEM:")[1].split("]")[0].strip()
                if os.path.exists(nome_img):
                    pdf.ln(5)
                    pdf.image(nome_img, x=15, w=170) # Insere a imagem grande no meio da página
                    pdf.ln(5)
                else:
                    pdf.set_text_color(255, 0, 0)
                    pdf.set_x(10)
                    pdf.multi_cell(0, 10, f"[Aviso: A imagem '{nome_img}' não foi encontrada na pasta]", ln=True)
                    pdf.set_text_color(0, 0, 0)
            except:
                pass
        else:
            if linha == "":
                pdf.ln(5) # Pula a linha de forma segura se estiver vazia
            else:
                pdf.set_x(10) # 🛡️ Garante que o cursor sempre comece encostado na margem esquerda
                pdf.multi_cell(0, 10, linha)
    
    # --- NOVO RODAPÉ COM O SEU NOME ---
    pdf.set_y(-15)
    pdf.set_font("Arial", "B", 8) 
    pdf.cell(0, 10, f"Documento gerado e revisado por Carlos Henrique - Editora Futura", align="C")
    
    return bytes(pdf.output())


