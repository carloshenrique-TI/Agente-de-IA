# --- FUNÇÕES AUXILIARES PARA GERAR O PDF ---
def _add_pdf_header(pdf, titulo_processo):
    pdf.set_fill_color(*PDF_FUTURA_PURPLE)
    pdf.rect(0, 0, 210, 40, 'F')

    if LOGO_PATH.exists():
        pdf.image(str(LOGO_PATH), 10, 5, 30)

    pdf.set_font("Arial", "B", 18)
    pdf.set_text_color(*PDF_WHITE)
    pdf.set_xy(45, 15)
    pdf.cell(0, 10, f"POP OFICIAL: {titulo_processo[:30]}...", ln=True)

def _add_pdf_body(pdf, conteudo_texto):
    pdf.set_xy(10, 50)
    pdf.set_text_color(*PDF_BLACK)
    pdf.set_font("Arial", "", 12)

    texto_limpo = conteudo_texto.replace("**", "").replace("📄 ", "").replace("🛠️ ", "").replace("⚠️ ", "")
    texto_limpo = texto_limpo.encode('latin-1', 'replace').decode('latin-1') # Para compatibilidade com FPDF

    linhas = texto_limpo.split('\n')
    for linha in linhas:
        linha = linha.strip()

        if "[IMAGEM:" in linha:
            try:
                nome_img = linha.split("[IMAGEM:")[1].split("]")[0].strip()
                if Path(nome_img).exists():
                    pdf.ln(5)
                    pdf.image(nome_img, x=15, w=170)
                    pdf.ln(5)
                else:
                    pdf.set_text_color(*PDF_ERROR_RED)
                    pdf.set_x(10)
                    pdf.multi_cell(0, 10, f"[Aviso: A imagem '{nome_img}' não foi encontrada]", ln=True)
                    pdf.set_text_color(*PDF_BLACK)
            except IndexError:
                # Se a linha contiver "[IMAGEM:" mas o formato estiver incorreto
                pdf.set_text_color(*PDF_ERROR_RED)
                pdf.set_x(10)
                pdf.multi_cell(0, 10, f"[Aviso: Tag de imagem mal formada: '{linha}']", ln=True)
                pdf.set_text_color(*PDF_BLACK)
        else:
            if linha == "":
                pdf.ln(5)
            else:
                pdf.set_x(10)
                pdf.multi_cell(0, 10, linha)

def _add_pdf_footer(pdf):
    pdf.set_y(-15)
    pdf.set_font("Arial", "B", 8)
    pdf.cell(0, 10, f"Documento gerado e revisado por Carlos Henrique - Editora Futura", align="C")

# --- FUNÇÃO MESTRE PARA GERAR O LAYOUT DO PDF ---
def criar_pdf_documento_visual(conteudo_texto, titulo_processo):
    pdf = FPDF()
    pdf.add_page()
    _add_pdf_header(pdf, titulo_processo)
    _add_pdf_body(pdf, conteudo_texto)
    _add_pdf_footer(pdf)
    return bytes(pdf.output())

