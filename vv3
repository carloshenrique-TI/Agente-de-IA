# 2. LEITURA DOS PDFS ANTIGOS (BASE DE CONHECIMENTO)
@st.cache_data
def carregar_base_conhecimento():
    texto_completo = ""
    POPS_DIR.mkdir(exist_ok=True) # Garante que a pasta exista
    if POPS_DIR.exists():
        for file_path in POPS_DIR.glob("*.pdf"):
            try:
                doc = fitz.open(file_path)
                for pagina in doc:
                    texto_completo += pagina.get_text()
                doc.close()
    return texto_completo

