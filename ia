# 2. LEITURA DOS PDFS ANTIGOS (BASE DE CONHECIMENTO)
@st.cache_data
def carregar_base_conhecimento():
    texto_completo = ""
    pasta_pops = "pops"
    if os.path.exists(pasta_pops):
        for ficheiro in os.listdir(pasta_pops):
            if ficheiro.endswith(".pdf"):
                caminho = os.path.join(pasta_pops, ficheiro)
                doc = fitz.open(caminho)
                for pagina in doc:
                    texto_completo += pagina.get_text()
                doc.close()
    return texto_completo

conhecimento_pops = carregar_base_conhecimento()

# --- FUNÇÃO MESTRE PARA GERAR O LAYOUT DO PDF ---
def criar_pdf_documento_visual(conteudo_texto, titulo_processo):
    pdf = FPDF()
    pdf.add_page()
    
    # --- LAYOUT CABEÇALHO ---
    # Barra Roxa no topo (Cor da Editora Futura)
    pdf.set_fill_color(106, 13, 173) # Tom de roxo
    pdf.rect(0, 0, 210, 40, 'F')
    
    # ---- AQUI ESTÁ A ALTERAÇÃO DA SUA IMAGEM ----
    if os.path.exists("images.jpg"):
        pdf.image("images.jpg", 10, 5, 30) # Ajustado a posição e tamanho para o robô aparecer bem
    
    # Título do Documento dentro da barra roxa
    pdf.set_font("Arial", "B", 18)
    pdf.set_text_color(255, 255, 255) # Texto Branco
    pdf.set_xy(45, 15)
    pdf.cell(0, 10, f"POP OFICIAL: {titulo_processo[:30]}...", ln=True)
    
    # --- CONTEÚDO DO DOCUMENTO ---
    pdf.set_xy(10, 50)
    pdf.set_text_color(0, 0, 0) # Texto Preto
    pdf.set_font("Arial", "", 12)
    
    # Limpeza básica do texto
    texto_limpo = conteudo_texto.replace("**", "").replace("📄 ", "").replace("🛠️ ", "").replace("⚠️ ", "")
    
    # Escrever o conteúdo multilinhas
    pdf.multi_cell(0, 10, texto_limpo)
    
    # Rodapé simples com data
    pdf.set_y(-15)
    pdf.set_font("Arial", "I", 8)
    pdf.cell(0, 10, f"Gerado automaticamente pelo Agente Atlas - Editora Futura", align="C")
    
    return bytes(pdf.output())


